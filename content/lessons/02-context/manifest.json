{
  "schema_version": "0.1.0",
  "id": "02-context",
  "version": "1.0.0",
  "order": 2,
  "title": "给 Agent 足够的资料",
  "description": "给 Agent 足够的资料的入门练习。",
  "objectives": [
    "给 Agent 足够的资料，并能核对操作过程和结果。"
  ],
  "intro_file": "intro.md",
  "task_file": "task.md",
  "completion_criteria": [
    "成功读取指定资料并核对事实和来源。"
  ],
  "initial_files": [
    {
      "id": "notice-week",
      "title": "课程通知",
      "path": "materials/notice.md",
      "media_type": "text/markdown"
    }
  ],
  "allowed_tools": [
    "list_materials",
    "read_material"
  ],
  "settings_policy": {
    "editable_fields": [
      "system_instruction",
      "temperature"
    ],
    "defaults": {
      "system_instruction": "根据课程资料完成任务，不猜测缺失信息，保存前请求批准。",
      "temperature": 0.3
    }
  },
  "answer_form": {
    "kind": "facts",
    "tasks": [
      {
        "task_id": "submit-summary",
        "label": "提交总结"
      },
      {
        "task_id": "reserve-lab",
        "label": "预约实验室"
      }
    ],
    "sources": [
      {
        "source_id": "notice-week",
        "label": "课程通知"
      }
    ]
  },
  "limits": {
    "max_model_calls": 10,
    "execution_timeout_seconds": 120,
    "approval_timeout_seconds": 600
  },
  "rules": [
    {
      "id": "read-and-facts",
      "required": true,
      "message": "成功读取指定资料并核对事实和来源。",
      "evaluator": "read_and_check_facts",
      "params": {
        "required_source_ids": [
          "notice-week"
        ],
        "expected_facts": [
          {
            "task_id": "submit-summary",
            "due_date": "2026-11-04",
            "source_id": "notice-week"
          },
          {
            "task_id": "reserve-lab",
            "due_date": "2026-11-06",
            "source_id": "notice-week"
          }
        ]
      }
    }
  ]
}
