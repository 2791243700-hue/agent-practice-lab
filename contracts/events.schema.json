{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StoredEvent v0.1.0",
  "oneOf": [
    {
      "$ref": "#/$defs/RunStartedEvent"
    },
    {
      "$ref": "#/$defs/MessageDeltaEvent"
    },
    {
      "$ref": "#/$defs/MessageCompletedEvent"
    },
    {
      "$ref": "#/$defs/ToolRequestedEvent"
    },
    {
      "$ref": "#/$defs/ApprovalRequestedEvent"
    },
    {
      "$ref": "#/$defs/ApprovalDecidedEvent"
    },
    {
      "$ref": "#/$defs/ToolCompletedEvent"
    },
    {
      "$ref": "#/$defs/RunCompletedEvent"
    },
    {
      "$ref": "#/$defs/RunFailedEvent"
    },
    {
      "$ref": "#/$defs/RunCancelledEvent"
    },
    {
      "$ref": "#/$defs/RunInterruptedEvent"
    }
  ],
  "discriminator": {
    "propertyName": "kind"
  },
  "$defs": {
    "Approval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "call_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "tool_name": {
          "type": "string",
          "const": "save_todos"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/TodoItem"
              },
              "maxItems": 20,
              "minItems": 1
            }
          },
          "required": [
            "items"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "approved",
            "denied",
            "expired",
            "cancelled"
          ]
        },
        "decision": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "approve",
                "deny"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "decided_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "run_id",
        "call_id",
        "tool_name",
        "arguments",
        "status",
        "decision",
        "created_at",
        "expires_at",
        "decided_at"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "type": "string",
                "const": "pending"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "decision": {
                "type": "null"
              },
              "decided_at": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "type": "string",
                "const": "approved"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "decision": {
                "type": "string",
                "const": "approve"
              },
              "decided_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "type": "string",
                "const": "denied"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "decision": {
                "type": "string",
                "const": "deny"
              },
              "decided_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "type": "string",
                "const": "expired"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "decision": {
                "type": "null"
              },
              "decided_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "type": "string",
                "const": "cancelled"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "decision": {
                "type": "null"
              },
              "decided_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      ]
    },
    "ApprovalDecidedEvent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "0.1.0"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "attempt_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "mode": {
          "type": "string",
          "enum": [
            "live",
            "demo"
          ]
        },
        "kind": {
          "type": "string",
          "const": "approval.decided"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "approval": {
              "$ref": "#/$defs/Approval"
            }
          },
          "required": [
            "approval"
          ]
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "attempt_id",
        "seq",
        "mode",
        "kind",
        "created_at",
        "payload"
      ]
    },
    "ApprovalRequestedEvent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "0.1.0"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "attempt_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "mode": {
          "type": "string",
          "enum": [
            "live",
            "demo"
          ]
        },
        "kind": {
          "type": "string",
          "const": "approval.requested"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "approval": {
              "$ref": "#/$defs/Approval"
            }
          },
          "required": [
            "approval"
          ]
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "attempt_id",
        "seq",
        "mode",
        "kind",
        "created_at",
        "payload"
      ]
    },
    "CourseResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "course_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "session_date": {
          "type": "string",
          "format": "date"
        },
        "room": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      },
      "required": [
        "course_id",
        "session_date",
        "room"
      ]
    },
    "DeniedToolResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "call_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "name": {
          "type": "string",
          "const": "save_todos"
        },
        "status": {
          "type": "string",
          "const": "denied"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          },
          "required": [
            "message"
          ]
        }
      },
      "required": [
        "call_id",
        "name",
        "status",
        "data"
      ]
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "VALIDATION_ERROR",
        "NOT_FOUND",
        "ORIGIN_REJECTED",
        "LOCAL_TOKEN_INVALID",
        "PROFILE_BUSY",
        "CREDENTIAL_MISSING",
        "MODEL_NOT_READY",
        "MODEL_AUTH_FAILED",
        "MODEL_TIMEOUT",
        "MODEL_INCOMPATIBLE",
        "MODEL_UNAVAILABLE",
        "RUN_BUSY",
        "ATTEMPT_BUSY",
        "ATTEMPT_SUPERSEDED",
        "REVISION_CONFLICT",
        "IDEMPOTENCY_CONFLICT",
        "IDEMPOTENCY_IN_PROGRESS",
        "APPROVAL_ALREADY_DECIDED",
        "APPROVAL_EXPIRED",
        "APPROVAL_INVALIDATED",
        "CURSOR_INVALID",
        "DEMO_DISABLED",
        "MODE_MISMATCH",
        "LIMIT_EXCEEDED",
        "RUN_TIMEOUT",
        "TOOL_ERROR",
        "EXECUTION_FAILED",
        "INTERNAL_ERROR",
        "MODEL_CATALOG_UNSUPPORTED",
        "MODEL_CATALOG_INVALID"
      ]
    },
    "ErrorResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "$ref": "#/$defs/ErrorCode"
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "request_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
            },
            "retryable": {
              "type": "boolean"
            },
            "fields": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/FieldError"
              },
              "maxItems": 100
            }
          },
          "required": [
            "code",
            "message",
            "request_id",
            "retryable",
            "fields"
          ]
        }
      },
      "required": [
        "error"
      ]
    },
    "FailedToolResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "call_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "name": {
          "type": "string",
          "enum": [
            "list_materials",
            "read_material",
            "lookup_course",
            "save_todos"
          ]
        },
        "status": {
          "type": "string",
          "const": "error"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "$ref": "#/$defs/ErrorCode"
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          },
          "required": [
            "code",
            "message"
          ]
        }
      },
      "required": [
        "call_id",
        "name",
        "status",
        "data"
      ]
    },
    "FieldError": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "required": [
        "path",
        "message"
      ]
    },
    "FileInfo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "material",
            "artifact"
          ]
        },
        "source_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "display_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "media_type": {
          "type": "string",
          "enum": [
            "text/plain",
            "text/markdown",
            "application/json"
          ]
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "kind",
        "source_id",
        "title",
        "display_path",
        "media_type",
        "size_bytes",
        "sha256",
        "created_at"
      ]
    },
    "ListMaterialsCall": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "name": {
          "type": "string",
          "const": "list_materials"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "properties": {},
          "required": []
        }
      },
      "required": [
        "id",
        "name",
        "arguments"
      ]
    },
    "ListMaterialsResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "call_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "name": {
          "type": "string",
          "const": "list_materials"
        },
        "status": {
          "type": "string",
          "const": "ok"
        },
        "data": {
          "$ref": "#/$defs/MaterialsResult"
        }
      },
      "required": [
        "call_id",
        "name",
        "status",
        "data"
      ]
    },
    "LookupCourseCall": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "name": {
          "type": "string",
          "const": "lookup_course"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "course_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
            }
          },
          "required": [
            "course_id"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "arguments"
      ]
    },
    "LookupCourseResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "call_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "name": {
          "type": "string",
          "const": "lookup_course"
        },
        "status": {
          "type": "string",
          "const": "ok"
        },
        "data": {
          "$ref": "#/$defs/CourseResult"
        }
      },
      "required": [
        "call_id",
        "name",
        "status",
        "data"
      ]
    },
    "MaterialInfo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "display_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "media_type": {
          "type": "string",
          "enum": [
            "text/plain",
            "text/markdown"
          ]
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        }
      },
      "required": [
        "id",
        "title",
        "display_path",
        "media_type",
        "size_bytes"
      ]
    },
    "MaterialResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "content": {
          "type": "string",
          "maxLength": 20000
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "source_id",
        "content",
        "truncated"
      ]
    },
    "MaterialsResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "materials": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MaterialInfo"
          },
          "maxItems": 100
        }
      },
      "required": [
        "materials"
      ]
    },
    "MessageCompletedEvent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "0.1.0"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "attempt_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "mode": {
          "type": "string",
          "enum": [
            "live",
            "demo"
          ]
        },
        "kind": {
          "type": "string",
          "const": "message.completed"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "message_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
            },
            "role": {
              "type": "string",
              "const": "assistant"
            },
            "content": {
              "type": "string",
              "maxLength": 100000
            }
          },
          "required": [
            "message_id",
            "role",
            "content"
          ]
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "attempt_id",
        "seq",
        "mode",
        "kind",
        "created_at",
        "payload"
      ]
    },
    "MessageDeltaEvent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "0.1.0"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "attempt_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "mode": {
          "type": "string",
          "enum": [
            "live",
            "demo"
          ]
        },
        "kind": {
          "type": "string",
          "const": "message.delta"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "message_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
            },
            "delta": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20000
            }
          },
          "required": [
            "message_id",
            "delta"
          ]
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "attempt_id",
        "seq",
        "mode",
        "kind",
        "created_at",
        "payload"
      ]
    },
    "ReadMaterialCall": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "name": {
          "type": "string",
          "const": "read_material"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "file_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
            }
          },
          "required": [
            "file_id"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "arguments"
      ]
    },
    "ReadMaterialResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "call_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "name": {
          "type": "string",
          "const": "read_material"
        },
        "status": {
          "type": "string",
          "const": "ok"
        },
        "data": {
          "$ref": "#/$defs/MaterialResult"
        }
      },
      "required": [
        "call_id",
        "name",
        "status",
