{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private Lesson Manifest v0.1.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "order": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      },
      "maxItems": 20
    },
    "intro_file": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+$",
      "maxLength": 300
    },
    "task_file": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+$",
      "maxLength": 300
    },
    "completion_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      },
      "maxItems": 20
    },
    "initial_files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+$",
            "maxLength": 300
          },
          "media_type": {
            "type": "string",
            "enum": [
              "text/plain",
              "text/markdown"
            ]
          }
        },
        "required": [
          "id",
          "title",
          "path",
          "media_type"
        ]
      },
      "maxItems": 100
    },
    "allowed_tools": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "list_materials",
          "read_material",
          "lookup_course",
          "save_todos"
        ]
      },
      "maxItems": 4,
      "uniqueItems": true
    },
    "settings_policy": {
      "$ref": "#/$defs/SettingsPolicy"
    },
    "answer_form": {
      "$ref": "#/$defs/AnswerForm"
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_model_calls": {
          "type": "number",
          "const": 10
        },
        "execution_timeout_seconds": {
          "type": "number",
          "const": 120
        },
        "approval_timeout_seconds": {
          "type": "number",
          "const": 600
        }
      },
      "required": [
        "max_model_calls",
        "execution_timeout_seconds",
        "approval_timeout_seconds"
      ]
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
              },
              "required": {
                "type": "boolean"
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "evaluator": {
                "type": "string",
                "const": "distinct_completed_runs"
              },
              "params": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "minimum": {
                    "type": "number",
                    "const": 2
                  }
                },
                "required": [
                  "minimum"
                ]
              }
            },
            "required": [
              "id",
              "required",
              "message",
              "evaluator",
              "params"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
              },
              "required": {
                "type": "boolean"
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "evaluator": {
                "type": "string",
                "const": "choice_answer"
              },
              "params": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "question_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
                  },
                  "correct_option_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
                  }
                },
                "required": [
                  "question_id",
                  "correct_option_id"
                ]
              }
            },
            "required": [
              "id",
              "required",
              "message",
              "evaluator",
              "params"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
              },
              "required": {
                "type": "boolean"
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "evaluator": {
                "type": "string",
                "const": "read_and_check_facts"
              },
              "params": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "required_source_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
                    },
                    "maxItems": 100,
                    "minItems": 1
                  },
                  "expected_facts": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/FactAnswer"
                    },
                    "maxItems": 20,
                    "minItems": 1
                  }
                },
                "required": [
                  "required_source_ids",
                  "expected_facts"
                ]
              }
            },
            "required": [
              "id",
              "required",
              "message",
              "evaluator",
              "params"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
              },
              "required": {
                "type": "boolean"
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "evaluator": {
                "type": "string",
                "const": "lookup_and_check_course"
              },
              "params": {
                "$ref": "#/$defs/CourseAnswers"
              }
            },
            "required": [
              "id",
              "required",
              "message",
              "evaluator",
              "params"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
              },
              "required": {
                "type": "boolean"
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "evaluator": {
                "type": "string",
                "const": "denied_without_write"
              },
              "params": {
                "type": "object",
                "additionalProperties": false,
                "properties": {},
                "required": []
              }
            },
            "required": [
              "id",
              "required",
              "message",
              "evaluator",
              "params"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
              },
              "required": {
                "type": "boolean"
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "evaluator": {
                "type": "string",
                "const": "approved_todos_artifact"
              },
              "params": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "expected_items": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/FactAnswer"
                    },
                    "maxItems": 20,
                    "minItems": 1
                  }
                },
                "required": [
                  "expected_items"
                ]
              }
            },
            "required": [
              "id",
              "required",
              "message",
              "evaluator",
              "params"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
              },
              "required": {
                "type": "boolean"
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "evaluator": {
                "type": "string",
                "const": "reflection_pair"
              },
              "params": {
                "type": "object",
                "additionalProperties": false,
                "properties": {},
                "required": []
              }
            },
            "required": [
              "id",
              "required",
              "message",
              "evaluator",
              "params"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
              },
              "required": {
                "type": "boolean"
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "evaluator": {
                "type": "string",
                "const": "reflection_change"
              },
              "params": {
                "type": "object",
                "additionalProperties": false,
                "properties": {},
                "required": []
              }
            },
            "required": [
              "id",
              "required",
              "message",
              "evaluator",
              "params"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
              },
              "required": {
                "type": "boolean"
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "evaluator": {
                "type": "string",
                "const": "reflection_quotes"
              },
              "params": {
                "type": "object",
                "additionalProperties": false,
                "properties": {},
                "required": []
              }
            },
            "required": [
              "id",
              "required",
              "message",
              "evaluator",
              "params"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
              },
              "required": {
                "type": "boolean"
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "evaluator": {
                "type": "string",
                "const": "reflection_challenge"
              },
              "params": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "challenge_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
                  },
                  "expected_judgments": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/ReflectionJudgment"
                    },
                    "minItems": 1,
                    "maxItems": 20
                  }
                },
                "required": [
                  "challenge_id",
                  "expected_judgments"
                ]
              }
            },
            "required": [
              "id",
              "required",
              "message",
              "evaluator",
              "params"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "id",
    "version",
    "order",
    "title",
    "description",
    "objectives",
    "intro_file",
    "task_file",
    "completion_criteria",
    "initial_files",
    "allowed_tools",
    "settings_policy",
    "answer_form",
    "limits",
    "rules"
  ],
  "$defs": {
    "AnswerForm": {
      "oneOf": [
        {
          "$ref": "#/$defs/ChoiceForm"
        },
        {
          "$ref": "#/$defs/FactsForm"
        },
        {
          "$ref": "#/$defs/CourseForm"
        },
        {
          "$ref": "#/$defs/ArtifactForm"
        },
        {
          "$ref": "#/$defs/ReflectionForm"
        }
      ],
      "discriminator": {
        "propertyName": "kind"
      }
    },
    "ArtifactForm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "const": "artifact"
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "required": [
        "kind",
        "prompt"
      ]
    },
    "Choice": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      },
      "required": [
        "id",
        "label"
      ]
    },
    "ChoiceForm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "const": "choice"
        },
        "question_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Choice"
          },
          "maxItems": 8,
          "minItems": 2
        }
      },
      "required": [
        "kind",
        "question_id",
        "prompt",
        "options"
      ]
    },
    "CourseAnswers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "course_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "session_date": {
          "type": "string",
          "format": "date"
        },
        "room": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      },
      "required": [
        "course_id",
        "session_date",
        "room"
      ]
    },
    "CourseForm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "const": "course"
        },
        "course_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "required": [
        "kind",
        "course_id",
        "prompt"
      ]
    },
    "FactAnswer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "due_date": {
          "type": "string",
          "format": "date"
        },
        "source_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        }
      },
      "required": [
        "task_id",
        "due_date",
        "source_id"
      ]
    },
    "FactsForm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "const": "facts"
        },
        "tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "task_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            },
            "required": [
              "task_id",
              "label"
            ]
          },
          "maxItems": 20,
          "minItems": 1
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            },
            "required": [
              "source_id",
              "label"
            ]
          },
          "maxItems": 20,
          "minItems": 1
        }
      },
      "required": [
        "kind",
        "tasks",
        "sources"
      ]
    },
    "Settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "system_instruction": {
          "type": "string",
          "maxLength": 2000
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "system_instruction",
        "temperature"
      ]
    },
    "SettingsPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "editable_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "system_instruction",
              "temperature"
            ]
          },
          "maxItems": 2
        },
        "defaults": {
          "$ref": "#/$defs/Settings"
        }
      },
      "required": [
        "editable_fields",
        "defaults"
      ]
    },
    "ReflectionForm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "const": "reflection"
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "challenge": {
          "$ref": "#/$defs/ReflectionChallenge"
        }
      },
      "required": [
        "kind",
        "prompt",
        "challenge"
      ]
    },
    "ReflectionChallenge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "notice": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "id",
              "label"
            ]
          },
          "minItems": 1,
          "maxItems": 20
        }
      },
      "required": [
        "id",
        "title",
        "notice",
        "items"
      ]
    },
    "ReflectionJudgment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "item_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "decision": {
          "type": "string",
          "enum": [
            "known",
            "confirm"
          ]
        }
      },
      "required": [
        "item_id",
        "decision"
      ]
    }
  }
}
