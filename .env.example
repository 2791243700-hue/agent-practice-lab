# Copy values to a private terminal environment for manual development.
# Prefer scripts/start.ps1: it generates a fresh local token in memory and shares it with child processes.
AGENT_SCHOOL_FRONTEND_ORIGIN=http://127.0.0.1:3000
AGENT_SCHOOL_API_ORIGIN=http://127.0.0.1:8000
AGENT_SCHOOL_DATA=./data
AGENT_SCHOOL_DEMO=0
# AGENT_SCHOOL_LOCAL_TOKEN is generated per process group. Never add NEXT_PUBLIC_ or commit a real value.
# Student model API keys are entered through the credential endpoint and never stored in this file.
